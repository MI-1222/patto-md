{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patto-md-web",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_API_URL": "https://patto-md-api.mi-1222.workers.dev"
  },
  "services": [
    {
      "binding": "API",
      "service": "patto-md-api"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  }
}
