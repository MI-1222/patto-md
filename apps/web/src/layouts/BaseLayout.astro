---
/**
 * 全ページ共通のベースレイアウトコンポーネント。
 * HTML骨格、メタタグ、ヘッダーおよびフッターを一元管理する。
 */
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { resolveServerApiBaseUrl } from '../lib/api';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'patto-md - Markdown文書を瞬時にWeb公開',
  description = 'ローカルのMarkdownファイルと添付画像をドラッグ&ドロップするだけで、即座にWeb公開・共有できるWebサービス。',
  image = '/ogp.jpeg',
} = Astro.props;

const ogImageUrl = new URL(image, Astro.url).href;

/** サーバーサイド実行時に解決されたAPIベースURL。 */
const resolvedApiUrl = resolveServerApiBaseUrl(Astro.locals);
---

<!doctype html>
<html lang="ja" class="h-full bg-neutral-950 text-neutral-100 antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    {resolvedApiUrl && <script
      is:inline
      define:vars={{ apiUrl: resolvedApiUrl }}
    >
      window.__PATTO_API_URL__ = apiUrl;
    </script>}

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph Protocol (OGP) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="patto-md" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="flex min-h-full flex-col bg-neutral-950 font-sans selection:bg-blue-500/20 selection:text-blue-300">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
