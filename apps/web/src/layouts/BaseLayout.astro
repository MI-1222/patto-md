---
/**
 * 全ページ共通のベースレイアウトコンポーネント。
 * HTML骨格、メタタグ、ヘッダーおよびフッターを一元管理する。
 */
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { resolveServerApiBaseUrl } from '../lib/api';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Cloudflare Turnstile スクリプトを含めるかどうか。 */
  includeTurnstile?: boolean;
  /** 正規化されたカノニカルURL。 */
  canonicalUrl?: string;
  /** OGP種別 (`website` または `article`)。デフォルトは `website`。 */
  ogType?: 'website' | 'article';
  /** Twitter Card 種別 (`summary` または `summary_large_image`)。デフォルトは `summary_large_image`。 */
  twitterCard?: 'summary' | 'summary_large_image';
  /** 検索エンジンのインデックス除外フラグ (`noindex, nofollow`)。 */
  noindex?: boolean;
  /** ドキュメント公開日時 (ISO 8601形式、`ogType === 'article'` 時に出力)。 */
  publishedTime?: string;
  /** ドキュメント最終更新日時 (ISO 8601形式、`ogType === 'article'` 時に出力)。 */
  modifiedTime?: string;
}

const {
  title = 'patto-md - Markdown文書を瞬時にWeb公開',
  description = 'ローカルのMarkdownファイルと添付画像をドラッグ&ドロップするだけで、即座にWeb公開・共有できるWebサービス。',
  image = '/ogp.jpeg',
  includeTurnstile = false,
  canonicalUrl,
  ogType = 'website',
  twitterCard = 'summary_large_image',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

/** OGP画像の完全修飾絶対URL。 */
const ogImageUrl =
  image.startsWith('http://') || image.startsWith('https://')
    ? image
    : new URL(image, Astro.url).href;

/** OGPで出力するパーマリンクURL。 */
const ogPageUrl = canonicalUrl || Astro.url.href;

/** サーバーサイド実行時に解決されたAPIベースURL。 */
const resolvedApiUrl = resolveServerApiBaseUrl(Astro.locals);
---

<!doctype html>
<html lang="ja" class="h-full bg-neutral-950 text-neutral-100 antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {resolvedApiUrl && <script
      is:inline
      define:vars={{ apiUrl: resolvedApiUrl }}
    >
      window.__PATTO_API_URL__ = apiUrl;
    </script>}

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph Protocol (OGP) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogPageUrl} />
    <meta property="og:site_name" content="patto-md" />
    <meta property="og:image" content={ogImageUrl} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {includeTurnstile && (
      <script
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
        async
        defer
      ></script>
    )}
  </head>
  <body class="flex min-h-full flex-col bg-neutral-950 font-sans selection:bg-blue-500/20 selection:text-blue-300">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
