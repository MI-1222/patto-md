---
/**
 * ドキュメント閲覧画面のエントリーポイント。
 *
 * エッジSSR上でAPIからMarkdown本文とメタデータを取得し、サーバーサイドでサニタイズ済みHTMLに変換して配信する。
 * パスコード保護ドキュメントの場合は認証状態を判定し、未認証時は本文レンダリングを遮断してロック画面を表示する。
 * 有効期限または保護状態に応じた `Cache-Control` ヘッダーの設定と、動的OGPメタタグの高度な出力を行う。
 */
/* eslint-disable astro/no-set-html-directive */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SLUG_PATTERN } from '@patto-md/shared';
import {
  fetchDocument,
  getFetcher,
  resolveServerApiBaseUrl,
} from '../../../lib/api';
import { renderMarkdown } from '../../../lib/markdown';
import { resolveDocumentOgp } from '../../../lib/ogp';
import {
  DocumentActionBar,
  PasscodeUnlockCard,
  ReportModal,
} from '../../../components/viewer';

const { id } = Astro.params;

if (!id || !SLUG_PATTERN.test(id)) {
  return Astro.redirect('/404');
}

/** サーバーサイド実行時に解決されたAPIベースURL。 */
const apiBaseUrl = resolveServerApiBaseUrl(Astro.locals);
/** サーバーサイド実行時に解決された `Fetcher` (`Service Binding` 優先)。 */
const fetcher = getFetcher(Astro.locals);

/** クライアントリクエストから受け取った `Cookie` ヘッダー。 */
const cookieHeader = Astro.request.headers.get('cookie');

let docData;
try {
  docData = await fetchDocument(id, apiBaseUrl, fetcher, {
    cookie: cookieHeader,
  });
} catch (error) {
  console.error('SSR fetchDocument エラー:', error);
  return Astro.redirect('/404');
}

const { document: doc, cacheControl } = docData;

if (cacheControl) {
  Astro.response.headers.set('Cache-Control', cacheControl);
}

const isProtected = Boolean(doc.isProtected);

/** 動的OGPメタデータの解決 (パスコード保護時のマスキングや先頭画像の解決を含む)。 */
const ogp = resolveDocumentOgp(doc, {
  currentUrl: Astro.url,
  assetBaseUrl: apiBaseUrl,
});

/** サーバーサイドでHTMLに変換されたMarkdown本文 (保護時は空文字列)。 */
let renderedHtml = '';
if (!isProtected && doc.content) {
  const rendered = await renderMarkdown(doc.content, {
    assetBaseUrl: apiBaseUrl,
  });
  renderedHtml = rendered.html;
}
---

<BaseLayout
  title={ogp.title}
  description={ogp.description}
  image={ogp.imageUrl}
  canonicalUrl={ogp.canonicalUrl}
  ogType={ogp.ogType}
  twitterCard={ogp.cardType}
  noindex={ogp.noindex}
  publishedTime={ogp.publishedTime}
  modifiedTime={ogp.modifiedTime}
>
  {isProtected ? (
    <div>
      <PasscodeUnlockCard client:load documentId={doc.id} title={doc.title} />
      <div class="mt-4">
        <ReportModal client:idle documentId={doc.id} />
      </div>
    </div>
  ) : (
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
      <div class="overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/40 shadow-2xl backdrop-blur-sm">
        <header class="border-b border-neutral-800 p-6 sm:p-8">
          <h1 class="text-2xl font-bold tracking-tight text-neutral-100 sm:text-3xl">
            {doc.title}
          </h1>
        </header>

        <DocumentActionBar
          client:load
          documentId={doc.id}
          rawMarkdown={doc.content}
          expiresAt={doc.expiresAt}
          createdAt={doc.createdAt}
          visibility={doc.visibility}
          ownerUserId={doc.ownerUserId}
          ownerProvider={doc.ownerProvider}
        />

        <div class="px-4 py-6 sm:px-8 sm:py-10">
          <!-- eslint-disable-next-line astro/no-set-html-directive -->
          <article
            class="prose prose-invert max-w-none pl-3.5 sm:pl-6 text-neutral-200 [&>h1:first-child]:hidden prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-neutral-100 prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline prose-code:rounded prose-code:bg-neutral-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-sm prose-code:text-neutral-200 prose-pre:border prose-pre:border-neutral-800 prose-pre:bg-neutral-950/80 prose-img:rounded-lg prose-table:overflow-x-auto"
            set:html={renderedHtml}
          />
        </div>

        <footer class="border-t border-neutral-800/60 bg-neutral-950/20 px-6 py-4 sm:px-8">
          <ReportModal client:idle documentId={doc.id} />
        </footer>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  import { renderAllMermaidBlocks } from '../../../lib/mermaid';
  import { initLineNumbersViewer } from '../../../lib/viewer/lineNumbers';

  const article = document.querySelector('article.prose');
  if (article instanceof HTMLElement) {
    /** コピー完了通知トーストを表示する。 */
    const showToast = (message: string) => {
      let toast = document.getElementById('line-link-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'line-link-toast';
        toast.className =
          'fixed bottom-6 right-6 z-50 flex items-center gap-2 rounded-lg border border-neutral-700 bg-neutral-900/95 px-4 py-2.5 text-xs font-medium text-emerald-400 shadow-2xl backdrop-blur-md transition-all duration-300 translate-y-2 opacity-0 pointer-events-none';
        document.body.appendChild(toast);
      }
      toast.textContent = message;
      toast.classList.remove('translate-y-2', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      const toastObj = toast as unknown as { _timer?: number };
      window.clearTimeout(toastObj._timer);
      toastObj._timer = window.setTimeout(() => {
        toast?.classList.remove('translate-y-0', 'opacity-100');
        toast?.classList.add('translate-y-2', 'opacity-0');
      }, 2500);
    };

    initLineNumbersViewer(article, (message) => {
      showToast(message);
    });
  }

  if (document.querySelector('.mermaid-block')) {
    void renderAllMermaidBlocks();
  }
</script>
