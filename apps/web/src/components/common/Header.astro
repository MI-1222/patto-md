---
/**
 * 全画面共通ヘッダーコンポーネント。
 * アプリケーションのロゴおよびリポジトリリンクを表示する。
 */
import { BrandLogoSvg } from '../svg/BrandLogo';
import GitHubIconSvg from '../svg/GitHubIcon.astro';
import OpenInNewSvg from '../svg/OpenInNew.astro';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<header
  class:list={`border-b border-neutral-800 bg-neutral-950/80 backdrop-blur-md sticky top-0 z-40 ${className}`}
>
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
    <div class="flex items-center gap-3">
      <a
        href="/"
        class="flex items-center gap-2.5 group transition-opacity hover:opacity-90"
      >
        <BrandLogoSvg className="size-8 transition-transform group-hover:scale-105" />
        <span class="font-mono text-lg font-bold tracking-tight text-neutral-100">
          patto-md
        </span>
      </a>
    </div>

    <nav class="flex items-center gap-4 text-sm text-neutral-400">
      <a
        href="https://github.com/MI-1222/patto-md"
        target="_blank"
        rel="noopener noreferrer"
        class="group/link flex items-center gap-2 text-neutral-400 transition-colors hover:text-neutral-100"
        aria-label="GitHub Repository"
      >
        <GitHubIconSvg class="size-4" />
        <span class="font-mono text-xs">GitHub</span>
        <OpenInNewSvg
          class="size-3 text-neutral-500 transition-colors group-hover/link:text-neutral-300"
          interactive={true}
        />
      </a>
    </nav>
  </div>
</header>
