    "preview": "wrangler pages dev dist --compatibility-date=2025-02-24 --compatibility-flags=nodejs_compat",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.2.0",
