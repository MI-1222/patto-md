{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patto-md-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  // 本番環境変数定義。
  "vars": {
    "DISCORD_CLIENT_ID": "1566018261005639740",
    "ENVIRONMENT": "production",
    "FRONTEND_ORIGIN": "https://patto-md-web.mi-1222.workers.dev",
    "GITHUB_CLIENT_ID": "Ov23lic6V2usSo1HogLR",
    "R2_BUCKET_NAME": "patto-md-r2"
  },
  // D1 データベースのバインディング定義。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patto-md-d1",
      "database_id": "999e0e2d-6fee-4a5d-ae55-525a57660260",
      "migrations_dir": "migrations"
    }
  ],
  // R2 オブジェクトストレージのバインディング定義。
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "patto-md-r2"
    }
  ]
}
