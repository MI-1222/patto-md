{
  "name": "@patto-md/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:expire:local": "node --experimental-strip-types scripts/expire-document.ts",
    "db:suspend:local": "node --experimental-strip-types scripts/suspend-document.ts",
    "db:suspend:remote": "node --experimental-strip-types scripts/suspend-document.ts --remote",
    "db:unsuspend:local": "node --experimental-strip-types scripts/unsuspend-document.ts",
    "db:unsuspend:remote": "node --experimental-strip-types scripts/unsuspend-document.ts --remote",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@patto-md/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.3",
    "wrangler": "^4"
  }
}
