{
  "name": "patto-md",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markdown文書と添付画像を即座にWeb公開するWebサービス。",
  "scripts": {
    "dev:web": "pnpm --filter @patto-md/web dev",
    "dev:api": "pnpm --filter @patto-md/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.72.0"
  }
}
